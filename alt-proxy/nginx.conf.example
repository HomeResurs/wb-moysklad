# Вариант для своего VPS с nginx (если PHP нет или не хочется его использовать).
# Добавьте внутрь блока server { ... } сайта relaxdev.ru, затем: nginx -t && systemctl reload nginx
# В index.html в CONFIG поменяйте:  PROXY_URL: '/ms-api'

location /ms-api/ {
    # Разрешаем только запросы со своего сайта
    if ($http_sec_fetch_site = "cross-site") { return 403; }

    proxy_pass https://api.moysklad.ru/api/remap/1.2/;
    proxy_ssl_server_name on;
    proxy_set_header Host api.moysklad.ru;
    proxy_set_header Authorization $http_x_ms_authorization;
    proxy_set_header X-Ms-Authorization "";
    proxy_set_header Cookie "";
    proxy_set_header Accept-Encoding "gzip";   # МойСклад требует gzip
    proxy_read_timeout 60s;
    client_max_body_size 5m;
}

# Ответ на проверку прокси (index.html делает GET /ms-api/ping)
location = /ms-api/ping {
    default_type application/json;
    return 200 '{"ok":true,"proxy":"nginx"}';
}

# Не отдавать служебные файлы
location ~ ^/(README\.md|nginx\.conf\.example|\.htaccess)$ { deny all; }
